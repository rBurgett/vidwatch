# Local development settings. Copy to api/.env (gitignored); the API and
# cmd/devsetup read it on start. Variables already set in your shell win.

PORT=8080
# Serve the frontend from the same origin, like CloudFront does in production.
STATIC_DIR=../web

# Local data: DynamoDB Local + LocalStack (S3). See README → Local development.
TABLE_NAME=vidwatch-local
MEDIA_BUCKET=vidwatch-media-local
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
S3_ENDPOINT=http://127.0.0.1:4566
MEDIA_BASE_URL=http://127.0.0.1:4566/vidwatch-media-local
AWS_REGION=us-east-1
# Dummy credentials for the emulators (they're never sent to real AWS).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Sign-in uses the real Cognito pool from the deployed stack (copy these from
# its Outputs). The stack allows http://localhost:8080/auth/callback.
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_DOMAIN=https://vidwatch-burgett.auth.us-east-1.amazoncognito.com

MAX_UPLOAD_MB=500
